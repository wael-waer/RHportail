# Créer un .gitignore complet pour Angular
@"
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular specific
.angular/
dist/
.aot/
*.ngsummary.json
*.ngfactory.ts

# Build outputs
out-tsc/
tmp/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Environment variables
.env
.env.local
.env.prod

# Cache
.cache/
"@ | Out-File -FilePath .gitignore -Encoding utf8